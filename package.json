{
  "name": "qawwam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emu",
    "build": "tsc --noEmit && vite build",
    "build:emu": "vite build --mode emu",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "emulators": "firebase emulators:start --project demo-qawwam",
    "test:db": "firebase emulators:exec --project demo-qawwam \"vitest run tests/emulator\"",
    "test:e2e": "firebase emulators:exec --project demo-qawwam \"playwright test\"",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
